# dependencies
node_modules/
backend/target/
.pnp
.pnp.js

# testing
coverage/

# production
build/
dist/

# terraform
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars

# editor / OS
.DS_Store
.idea/

# env files
.env
.env.local
.env.*.local

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# local paste captures
.sulion-paste/

# illuminator generation output; the processed masks that ship are copied into
